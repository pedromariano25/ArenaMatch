# Modelo de configuração. Copie para .env (que NÃO é versionado) e preencha.

# Obrigatória. Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Use True apenas em desenvolvimento local.
DJANGO_DEBUG=True

# Hosts aceitos pelo servidor, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Obrigatória. Conexão com o PostgreSQL: postgres://usuario:senha@host:porta/banco
# Caracteres especiais na senha precisam de URL encoding (ex.: # vira %23).
# O usuário precisa da permissão CREATEDB para rodar os testes.
DATABASE_URL=postgres://arenamatch:troque-esta-senha@localhost:5432/arenamatch

# Pagamentos: gateway simulado em desenvolvimento (em produção, um gateway real).
# ARENAMATCH_GATEWAY_PAGAMENTO=arena.pagamentos.MockGateway
# ARENAMATCH_PERMITIR_GATEWAY_SIMULADO=True

# Envio do código de acesso por SMS. O padrão só registra no log (desenvolvimento).
# ARENAMATCH_SMS_BACKEND=arena.acesso.SmsConsole

# Endereço público do site, usado nos links dos e-mails.
# ARENAMATCH_URL_BASE=http://127.0.0.1:8000
