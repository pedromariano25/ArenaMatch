# Modelo de configuração. Copie para .env (que NÃO é versionado) e preencha.

# Obrigatória. Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Use True apenas em desenvolvimento local.
DJANGO_DEBUG=True

# Hosts aceitos pelo servidor, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
